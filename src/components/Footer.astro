---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-full.png';
import Icon from './Icon.astro';
import { site, nav, tel, mailto } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="bg-shell pb-28 md:pb-0">
  <div class="mx-auto grid max-w-6xl gap-10 border-t border-sand-300 px-4 py-14 sm:px-6 md:grid-cols-12">
    <div class="md:col-span-4">
      <Image src={logo} alt={site.name} width={220} class="h-auto w-44" />
      <p class="mt-4 max-w-xs text-ink-muted">Mobile boat repair at your dock, marina, or home across South Florida.</p>
    </div>

    <nav aria-label="Footer" class="md:col-span-2">
      <h2 class="eyebrow">Menu</h2>
      <ul class="mt-4 space-y-2.5">
        {nav.map((item) => <li><a href={item.href} class="hover:text-sun-700">{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="md:col-span-3">
      <h2 class="eyebrow">Service area</h2>
      <ul class="mt-4 space-y-2.5 text-ink-muted">
        {site.areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div class="md:col-span-3">
      <h2 class="eyebrow">Get in touch</h2>
      <ul class="mt-4 space-y-3">
        <li><a href={tel} class="flex items-center gap-2.5 font-semibold hover:text-sun-700"><Icon name="phone" class="size-4 text-sun-700" />{site.phoneDisplay}</a></li>
        <li><a href={mailto} class="flex items-center gap-2.5 break-all hover:text-sun-700"><Icon name="mail" class="size-4 shrink-0 text-sun-700" />{site.email}</a></li>
        <li class="flex gap-3 pt-2">
          <a href={site.instagram} target="_blank" rel="noopener" aria-label={`Instagram ${site.instagramHandle}`} class="inline-flex size-11 items-center justify-center rounded-full bg-navy-900 text-white transition hover:bg-sun-500 hover:text-navy-900">
            <Icon name="instagram" class="size-5" />
          </a>
          <a href={site.tiktok} target="_blank" rel="noopener" aria-label={`TikTok ${site.tiktokHandle}`} class="inline-flex size-11 items-center justify-center rounded-full bg-navy-900 text-white transition hover:bg-sun-500 hover:text-navy-900">
            <Icon name="tiktok" class="size-5" />
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="mx-auto flex max-w-6xl flex-col gap-2 border-t border-sand-300 px-4 py-6 text-sm text-ink-muted sm:flex-row sm:justify-between sm:px-6">
    <p>© {year} {site.name}</p>
    <p>Palm Beach · Broward · Miami-Dade</p>
  </div>
</footer>
