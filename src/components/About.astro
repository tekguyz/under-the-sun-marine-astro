---
import { Picture } from 'astro:assets';
import { about } from '../data/photos';
---
<section id="about" class="section overflow-x-clip bg-sand" aria-labelledby="about-title">
  <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <div class="relative mx-auto max-w-md">
        <div class="sun-disc absolute -top-8 -left-6 size-40 sm:-left-10 sm:size-56" aria-hidden="true"></div>
        <Picture
          src={about.src}
          alt={about.alt}
          formats={['avif', 'webp']}
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 420px, (min-width: 640px) 448px, 100vw"
          class="relative aspect-4/5 w-full rounded-[2rem] object-cover shadow-[0_30px_60px_-24px_rgb(10_27_63/0.45)]"
        />
      </div>
    </div>

    <div class="lg:col-span-7" data-reveal style="--reveal-delay:120ms">
      <h2 id="about-title" class="section-title">Honest work. Fair prices. Your boat, treated like mine.</h2>
      <div class="mt-7 max-w-[62ch] space-y-5 text-lg leading-relaxed text-ink-muted">
        <p>
          Hey, my name is Jack and I run <strong class="font-semibold text-navy-900">Under The Sun Marine</strong>.
          I’ve spent a lot of time working on boats, and I genuinely have a passion for marine repair and keeping people out on the water.
        </p>
        <p>
          I offer mobile boat repair and come directly to your dock, marina, or home anywhere in South Florida.
          Whether your engine isn’t running right, your lights stopped working, or you just want your boat cleaned up and detailed, I’d be happy to help.
        </p>
        <p>
          I take pride in honest work, fair pricing, and treating every boat like it’s my own.
          Reach out anytime with questions or issues you’re having with your boat.
        </p>
      </div>
      <p class="mt-8 flex items-center gap-3 font-display text-2xl font-extrabold text-navy-900 uppercase italic">
        <span class="h-0.5 w-10 bg-sun-500" aria-hidden="true"></span>
        Jack, owner
      </p>
    </div>
  </div>
</section>
