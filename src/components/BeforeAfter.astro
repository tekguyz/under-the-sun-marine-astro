---
import { Picture } from 'astro:assets';
import { before, after } from '../data/photos';

const imgProps = {
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  widths: [480, 800, 1100],
  sizes: '(min-width: 768px) 640px, 100vw',
};
---
<section id="results" class="section bg-navy-900 text-white" aria-labelledby="results-title">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <p class="text-sm font-semibold tracking-[0.18em] text-sun-400 uppercase">Before &amp; after</p>
      <h2 id="results-title" class="mt-3 font-display text-4xl leading-[0.95] font-extrabold tracking-tight uppercase italic sm:text-5xl">
        From rat’s nest to ship-shape
      </h2>
      <p class="mt-5 text-lg text-white/75">Drag the handle to see a real wiring job, before and after Jack.</p>
    </div>

    <div class="lg:col-span-7" data-reveal style="--reveal-delay:120ms">
      <div data-ba class="ba relative mx-auto max-w-xl overflow-hidden rounded-3xl shadow-2xl" style="--pos:50%">
        <figure class="ba-after">
          <Picture src={after.src} alt={after.alt} {...imgProps} class="aspect-4/5 w-full object-cover" />
          <figcaption class="ba-label right-4">After</figcaption>
        </figure>
        <figure class="ba-before">
          <Picture src={before.src} alt={before.alt} {...imgProps} class="aspect-4/5 w-full object-cover" />
          <figcaption class="ba-label left-4">Before</figcaption>
        </figure>
        <div class="ba-handle" aria-hidden="true"><span></span></div>
        <input
          data-ba-range
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Drag to compare before and after"
          class="ba-range"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* No JS: simple two-up grid. */
  .ba { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .ba-range, .ba-handle { display: none; }
  .ba-label {
    position: absolute; top: 1rem; border-radius: 9999px; background: rgb(10 27 63 / 0.8);
    padding: 0.25rem 0.75rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: white;
  }
  figure { position: relative; margin: 0; }

  /* JS: stacked comparison. */
  :global(.js) .ba { display: block; }
  :global(.js) .ba-before {
    position: absolute; inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  :global(.js) .ba-handle {
    display: block; position: absolute; top: 0; bottom: 0; left: var(--pos);
    width: 3px; transform: translateX(-50%); background: white; pointer-events: none;
  }
  :global(.js) .ba-handle span {
    position: absolute; top: 50%; left: 50%; width: 3rem; height: 3rem; transform: translate(-50%, -50%);
    border-radius: 9999px; background: #f26a21; box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
  }
  :global(.js) .ba-handle span::before {
    content: '‹ ›'; position: absolute; inset: 0; display: grid; place-items: center;
    color: #0a1b3f; font-weight: 800; font-size: 1.1rem;
  }
  :global(.js) .ba-range {
    display: block; position: absolute; inset: 0; width: 100%; height: 100%;
    margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y;
  }
  :global(.js) .ba:has(.ba-range:focus-visible) .ba-handle span {
    outline: 3px solid white; outline-offset: 3px;
  }
</style>

<script>
  import '../scripts/before-after.ts';
</script>
