---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { gallery } from '../data/photos';

const items = await Promise.all(
  gallery.map(async (photo) => ({
    ...photo,
    full: await getImage({ src: photo.src, width: Math.min(1800, photo.src.width), format: 'webp' }),
  })),
);
---
<section id="work" class="section bg-shell" aria-labelledby="work-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div class="max-w-xl">
        <p class="eyebrow">Recent work</p>
        <h2 id="work-title" class="section-title">Real boats. Real docks.</h2>
      </div>
      <p class="max-w-sm text-ink-muted">Every photo here is from a real job. Tap one to see it bigger.</p>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
      {items.map((item, i) => (
        <li
          data-reveal
          style={`--reveal-delay:${(i % 4) * 70}ms`}
          class={i === 0 ? 'col-span-2 row-span-2' : ''}
        >
          <a
            href={item.full.src}
            data-lightbox
            data-alt={item.alt}
            class="group relative block h-full overflow-hidden rounded-2xl bg-sand"
          >
            <Picture
              src={item.src}
              alt={item.alt}
              formats={['avif', 'webp']}
              widths={i === 0 ? [480, 800, 1200] : [320, 480, 640]}
              sizes={i === 0 ? '(min-width: 768px) 560px, 100vw' : '(min-width: 768px) 270px, 50vw'}
              class="aspect-square h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <span class="absolute inset-0 bg-navy-900/0 transition group-hover:bg-navy-900/20" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<dialog
  id="lightbox"
  aria-label="Photo viewer"
  class="m-auto max-h-none max-w-none bg-transparent p-0 text-white backdrop:bg-navy-950/90 open:flex open:h-dvh open:w-screen open:flex-col open:items-center open:justify-center"
>
  <button data-close type="button" class="absolute top-4 right-4 inline-flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Close">
    <Icon name="x" class="size-6" />
  </button>
  <img src="" alt="" class="max-h-[78dvh] max-w-[92vw] rounded-xl object-contain shadow-2xl" />
  <div class="mt-4 flex w-full max-w-3xl items-center justify-between gap-4 px-4">
    <button data-prev type="button" class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Previous photo">
      <Icon name="chevron-left" class="size-6" />
    </button>
    <div class="text-center">
      <p data-caption class="text-sm text-white/85"></p>
      <p data-counter class="mt-1 text-xs tracking-widest text-white/60"></p>
    </div>
    <button data-next type="button" class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Next photo">
      <Icon name="chevron-right" class="size-6" />
    </button>
  </div>
</dialog>

<script>
  import '../scripts/lightbox.ts';
</script>
