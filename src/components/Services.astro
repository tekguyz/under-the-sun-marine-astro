---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<section id="services" class="section bg-shell" aria-labelledby="services-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">What Jack does</p>
      <h2 id="services-title" class="section-title">Engine, electrical &amp; detailing. Done at your slip.</h2>
      <p class="mt-5 text-lg text-ink-muted">
        No trailer. No weeks waiting at a boatyard. Pick what you need, or just describe the problem.
      </p>
    </div>

    <ul class="mt-14 grid gap-5 md:grid-cols-3">
      {services.map((service, i) => (
        <li
          data-service
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
          class="group flex flex-col rounded-3xl bg-white p-7 ring-1 ring-sand-300 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-navy-900/5 sm:p-8"
        >
          <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-navy-900 text-sun-400 transition-transform duration-300 group-hover:-rotate-6">
            <Icon name={service.icon} class="size-6" />
          </span>
          <h3 class="mt-6 font-display text-3xl font-bold tracking-tight text-navy-900 uppercase italic">{service.title}</h3>
          <p class="mt-2 text-ink-muted">{service.summary}</p>
          <ul class="mt-6 space-y-2.5 border-t border-sand-300 pt-6">
            {service.items.map((item) => (
              <li class="flex items-start gap-2.5 font-medium">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-sun-700" />
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
