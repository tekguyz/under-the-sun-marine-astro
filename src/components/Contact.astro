---
import Icon from './Icon.astro';
import { site, tel, sms, mailto, serviceOptions } from '../data/site';

const input =
  'mt-2 block w-full rounded-xl border border-sand-300 bg-shell px-4 py-3 text-base text-ink placeholder:text-ink-muted/70 transition focus:border-sun-500 focus:bg-white focus:ring-3 focus:ring-sun-500/25 focus:outline-none aria-invalid:border-red-600';
const label = 'block text-sm font-semibold text-navy-900';
const error = 'mt-1 min-h-5 text-sm font-medium text-red-700';
---
<section id="contact" class="section bg-shell" aria-labelledby="contact-title">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <h2 id="contact-title" class="section-title">Tell Jack what’s going on</h2>
      <p class="mt-5 max-w-md text-lg text-ink-muted">
        Send the details and Jack will get back to you. Out on a job all day? A call or text is the fastest way to reach him.
      </p>

      <a href={tel} class="group mt-10 block w-fit">
        <span class="label">Call or text</span>
        <span class="mt-1 block font-display text-[2.75rem] leading-none font-extrabold tracking-[-0.01em] text-navy-900 italic tabular-nums transition-colors group-hover:text-sun-700 sm:text-6xl">
          {site.phoneDisplay}
        </span>
      </a>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={sms} class="btn btn-dark px-6 py-3"><Icon name="message" class="size-4 text-sun-400" /> Text Jack</a>
        <a href={tel} class="btn btn-ghost px-6 py-3"><Icon name="phone" class="size-4 text-sun-700" /> Call</a>
      </div>

      <a href={mailto} class="mt-6 inline-flex items-center gap-2.5 font-semibold break-all text-navy-900 underline decoration-sand-300 decoration-2 underline-offset-4 hover:decoration-sun-500">
        <Icon name="mail" class="size-4 shrink-0 text-sun-700" />{site.email}
      </a>
    </div>

    <div class="lg:col-span-7" data-reveal style="--reveal-delay:120ms">
      <div class="rounded-[2rem] bg-white p-6 shadow-[0_30px_60px_-30px_rgb(10_27_63/0.25)] ring-1 ring-sand-300 sm:p-10">
        <form
          name="contact"
          method="POST"
          action="/thanks"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-phone={site.phoneDisplay}
          class="grid gap-x-5 gap-y-3 sm:grid-cols-2"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div>
            <label for="name" class={label}>Your name</label>
            <input id="name" name="name" type="text" required minlength="2" autocomplete="name" class={input} aria-describedby="name-error" />
            <p id="name-error" class={error} aria-live="polite"></p>
          </div>

          <div>
            <label for="phone" class={label}>Phone</label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(561) 555-0199" class={input} aria-describedby="phone-error" />
            <p id="phone-error" class={error} aria-live="polite"></p>
          </div>

          <div>
            <label for="email" class={label}>Email <span class="font-normal text-ink-muted">(optional)</span></label>
            <input id="email" name="email" type="email" autocomplete="email" class={input} aria-describedby="email-error" />
            <p id="email-error" class={error} aria-live="polite"></p>
          </div>

          <div>
            <label for="service" class={label}>Service</label>
            <select id="service" name="service" class={input}>
              {serviceOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
            <p id="service-error" class={error} aria-live="polite"></p>
          </div>

          <div class="sm:col-span-2">
            <label for="boat" class={label}>Boat &amp; engine <span class="font-normal text-ink-muted">(optional)</span></label>
            <input id="boat" name="boat" type="text" placeholder="e.g. 25' Grady-White, twin Yamaha 250s" class={input} aria-describedby="boat-error" />
            <p id="boat-error" class={error} aria-live="polite"></p>
          </div>

          <div class="sm:col-span-2">
            <label for="message" class={label}>What’s going on?</label>
            <textarea id="message" name="message" rows="4" required minlength="5" placeholder="e.g. Engine cranks but won’t start" class={`${input} resize-y`} aria-describedby="message-error"></textarea>
            <p id="message-error" class={error} aria-live="polite"></p>
          </div>

          <div class="pt-1 sm:col-span-2">
            <button type="submit" class="btn btn-primary group w-full py-4 text-base data-loading:opacity-70">
              <span>Send request</span>
              <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
            </button>
            <p id="contact-status" class="mt-3 text-center text-sm text-ink-muted data-[state=error]:font-semibold data-[state=error]:text-red-700" aria-live="polite"></p>
          </div>
        </form>

        <div id="contact-success" tabindex="-1" hidden class="py-10 text-center outline-none">
          <span class="sun-disc mx-auto inline-flex size-16 items-center justify-center text-navy-900">
            <Icon name="check" class="size-8" />
          </span>
          <h3 class="mt-6 font-display text-4xl font-extrabold text-navy-900 uppercase italic">Got it. Thanks!</h3>
          <p class="mx-auto mt-3 max-w-md text-lg text-ink-muted">
            Jack will reach out soon. Need him faster? Call or text <a href={tel} class="font-semibold text-navy-900 underline underline-offset-4">{site.phoneDisplay}</a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/contact-form.ts';
</script>
