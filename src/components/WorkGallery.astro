---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { gallery } from '../data/photos';

const items = await Promise.all(
  gallery.map(async (photo) => ({
    ...photo,
    full: await getImage({ src: photo.src, width: Math.min(1800, photo.src.width), format: 'webp' }),
  })),
);

// Grid math: tile 0 is 2x2 and the last tile spans 2 columns, so 2- and 4-column grids fill with no holes.
const last = items.length - 1;
const tileClass = (i: number) => (i === 0 ? 'col-span-2 row-span-2' : i === last ? 'col-span-2' : '');
const imgClass = (i: number) =>
  i === last ? 'aspect-2/1 h-full w-full object-cover' : 'aspect-square h-full w-full object-cover';
---
<section id="work" class="section bg-shell" aria-labelledby="work-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-10" data-reveal>
      <h2 id="work-title" class="section-title lg:col-span-7">Real boats. Real docks.</h2>
      <p class="max-w-md text-lg text-ink-muted lg:col-span-5 lg:pb-1">Every photo here is from a real job. Tap one to see it bigger.</p>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-2.5 sm:mt-16 sm:gap-4 md:grid-cols-4">
      {items.map((item, i) => (
        <li data-reveal style={`--reveal-delay:${(i % 4) * 60}ms`} class={tileClass(i)}>
          <a
            href={item.full.src}
            data-lightbox
            data-alt={item.alt}
            class="group relative block h-full overflow-hidden rounded-2xl bg-sand"
          >
            <Picture
              src={item.src}
              alt={item.alt}
              formats={['avif', 'webp']}
              widths={i === 0 ? [480, 800, 1200] : i === last ? [480, 800, 1100] : [320, 480, 640]}
              sizes={i === 0 || i === last ? '(min-width: 768px) 560px, 100vw' : '(min-width: 768px) 270px, 50vw'}
              class={`${imgClass(i)} transition duration-700 ease-out group-hover:scale-105`}
            />
            <span class="absolute inset-0 bg-linear-to-t from-navy-900/50 via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true"></span>
            <span class="absolute right-3 bottom-3 inline-flex size-10 translate-y-2 items-center justify-center rounded-full bg-shell text-navy-900 opacity-0 shadow-lg transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100" aria-hidden="true">
              <Icon name="arrow-right" class="size-4 -rotate-45" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<dialog
  id="lightbox"
  aria-label="Photo viewer"
  class="m-auto max-h-none max-w-none bg-transparent p-0 text-white backdrop:bg-navy-950/92 backdrop:backdrop-blur-sm open:flex open:h-dvh open:w-screen open:flex-col open:items-center open:justify-center"
>
  <button data-close type="button" class="absolute top-4 right-4 inline-flex size-12 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20" aria-label="Close">
    <Icon name="x" class="size-6" />
  </button>
  <!-- Starts on the first photo; the script swaps it. A closed dialog is display:none, so this never downloads on load. -->
  <img src={items[0].full.src} alt="" loading="lazy" decoding="async" class="max-h-[78dvh] max-w-[92vw] rounded-2xl object-contain shadow-2xl" />
  <div class="mt-4 flex w-full max-w-3xl items-center justify-between gap-4 px-4">
    <button data-prev type="button" class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20" aria-label="Previous photo">
      <Icon name="chevron-left" class="size-6" />
    </button>
    <div class="text-center">
      <p data-caption class="text-sm text-white/85"></p>
      <p data-counter class="mt-1 text-xs tracking-widest text-white/70 tabular-nums"></p>
    </div>
    <button data-next type="button" class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20" aria-label="Next photo">
      <Icon name="chevron-right" class="size-6" />
    </button>
  </div>
</dialog>

<script>
  import '../scripts/lightbox.ts';
</script>
