---
import Icon from './Icon.astro';
import { tel, sms } from '../data/site';
---
<div
  data-callbar
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-sand-300 bg-shell/95 px-3 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md transition-transform duration-300 ease-out data-hidden:translate-y-full md:hidden"
>
  <a href={sms} class="btn btn-ghost py-3"><Icon name="message" class="size-4" /> Text</a>
  <a href={tel} class="btn btn-primary py-3"><Icon name="phone" class="size-4" /> Call Jack</a>
</div>

<script>
  // Hide the bar while the hero buttons or the contact section are on screen.
  const bar = document.querySelector<HTMLElement>('[data-callbar]');
  const watched = [document.querySelector('[data-hero-cta]'), document.getElementById('contact')].filter(
    (el): el is Element => el !== null,
  );

  if (bar && watched.length && 'IntersectionObserver' in window) {
    const onScreen = new Set<Element>();
    const setHidden = (hidden: boolean) => {
      bar.toggleAttribute('data-hidden', hidden);
      bar.inert = hidden;
    };
    setHidden(true);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        setHidden(onScreen.size > 0);
      },
      { threshold: 0.1 },
    );
    watched.forEach((el) => observer.observe(el));
  }
</script>
