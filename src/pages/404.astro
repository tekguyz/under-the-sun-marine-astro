---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Page not found | ${site.name}`} path="/404" noindex>
  <main class="flex min-h-dvh items-center justify-center bg-navy-900 px-4 text-center text-white">
    <div class="max-w-lg">
      <p class="text-sm font-semibold tracking-[0.18em] text-sun-400 uppercase">404</p>
      <h1 class="mt-3 font-display text-6xl font-extrabold uppercase italic">Lost at sea</h1>
      <p class="mt-4 text-lg text-white/80">That page doesn’t exist.</p>
      <a href="/" class="btn btn-primary mt-8 px-7 py-3.5">Back to home</a>
    </div>
  </main>
</Base>
