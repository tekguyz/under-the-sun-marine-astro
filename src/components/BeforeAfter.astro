---
import { Picture } from 'astro:assets';
import WaveDivider from './WaveDivider.astro';
import { before, after } from '../data/photos';

const imgProps = {
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  widths: [480, 800, 1100],
  sizes: '(min-width: 768px) 576px, 100vw',
};
---
<section id="results" class="relative bg-navy-900 text-white" aria-labelledby="results-title">
  <WaveDivider flip class="-mt-px text-shell" />
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <h2 id="results-title" class="font-display text-[2.5rem] leading-[0.92] font-extrabold tracking-[-0.01em] uppercase italic sm:text-6xl">
        From rat’s nest to <span class="text-sun-400">ship-shape</span>
      </h2>
      <p class="mt-5 max-w-sm text-lg text-white/75">Drag the handle to see a real wiring job, before and after Jack.</p>
    </div>

    <div class="lg:col-span-7" data-reveal style="--reveal-delay:120ms">
      <div data-ba class="ba relative mx-auto max-w-xl overflow-hidden rounded-[2rem] shadow-[0_30px_60px_-20px_rgb(0_0_0/0.6)]" style="--pos:50%">
        <figure class="ba-after">
          <Picture src={after.src} alt={after.alt} {...imgProps} class="aspect-4/5 w-full object-cover" />
          <figcaption class="ba-label right-4">After</figcaption>
        </figure>
        <figure class="ba-before">
          <Picture src={before.src} alt={before.alt} {...imgProps} class="aspect-4/5 w-full object-cover" />
          <figcaption class="ba-label left-4">Before</figcaption>
        </figure>
        <div class="ba-handle" aria-hidden="true">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 17-5-5 5-5" /><path d="m15 7 5 5-5 5" />
            </svg>
          </span>
        </div>
        <input
          data-ba-range
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Drag to compare before and after"
          aria-valuetext="Half before, half after"
          class="ba-range"
        />
      </div>
    </div>
  </div>
  <WaveDivider class="-mb-px text-shell" />
</section>

<style>
  /* No JS: simple two-up grid. */
  .ba { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .ba-range, .ba-handle { display: none; }
  .ba-label {
    position: absolute; top: 1rem; border-radius: 9999px; background: rgb(10 27 63 / 0.85);
    padding: 0.3rem 0.8rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: white;
  }
  figure { position: relative; margin: 0; }

  /* JS: stacked comparison, dragged anywhere on the photo. */
  :global(.js) .ba { display: block; touch-action: pan-y; cursor: ew-resize; user-select: none; }
  :global(.js) .ba img { pointer-events: none; }
  :global(.js) .ba-before {
    position: absolute; inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  :global(.js) .ba-handle {
    display: block; position: absolute; top: 0; bottom: 0; left: var(--pos);
    width: 3px; transform: translateX(-50%); background: white; pointer-events: none;
    box-shadow: 0 0 12px rgb(0 0 0 / 0.35);
  }
  :global(.js) .ba-handle span {
    position: absolute; top: 50%; left: 50%; display: grid; place-items: center;
    width: 3.25rem; height: 3.25rem; transform: translate(-50%, -50%);
    border-radius: 9999px; background: #f26a21; color: #0a1b3f;
    box-shadow: 0 10px 24px -6px rgb(0 0 0 / 0.45);
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.js) .ba-handle svg { width: 1.5rem; height: 1.5rem; }
  :global(.js) .ba[data-dragging] .ba-handle span { transform: translate(-50%, -50%) scale(1.12); }
  :global(.js) .ba-range {
    display: block; position: absolute; inset: 0; width: 100%; height: 100%;
    margin: 0; opacity: 0; pointer-events: none;
  }
  :global(.js) .ba:has(.ba-range:focus-visible) .ba-handle span {
    outline: 3px solid white; outline-offset: 3px;
  }
</style>

<script>
  import '../scripts/before-after.ts';
</script>
