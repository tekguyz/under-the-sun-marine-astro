---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<section id="services" class="section bg-shell" aria-labelledby="services-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-10" data-reveal>
      <h2 id="services-title" class="section-title lg:col-span-7">Engine, electrical &amp; detailing. Done at your slip.</h2>
      <p class="max-w-md text-lg text-ink-muted lg:col-span-5 lg:pb-1">
        No trailer. No weeks waiting at a boatyard. Pick what you need, or just describe the problem.
      </p>
    </div>

    <ul class="mt-12 border-t-2 border-navy-900 sm:mt-16">
      {services.map((service, i) => (
        <li
          data-service
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
          class="group grid gap-6 border-b border-sand-300 py-9 sm:py-11 md:grid-cols-12 md:gap-10"
        >
          <div class="flex items-start gap-4 md:col-span-6 lg:col-span-5">
            <span class="mt-1 inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-sun-500 text-navy-900 transition-transform duration-300 group-hover:-rotate-12">
              <Icon name={service.icon} class="size-5" />
            </span>
            <div>
              <h3 class="font-display text-3xl leading-none font-extrabold tracking-[-0.01em] text-navy-900 uppercase italic sm:text-4xl">{service.title}</h3>
              <p class="mt-3 max-w-sm text-ink-muted">{service.summary}</p>
            </div>
          </div>
          <ul class="grid content-start gap-x-8 gap-y-3 pl-15 sm:grid-cols-2 md:col-span-6 md:pt-1.5 md:pl-0 lg:col-span-7">
            {service.items.map((item) => (
              <li class="flex items-start gap-2.5 text-lg">
                <Icon name="check" class="mt-1.5 size-4 shrink-0 text-sun-700" />
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <p class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 text-ink-muted" data-reveal>
      <a href="#contact" class="btn btn-dark group px-6 py-3">
        Tell Jack what’s wrong <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
      Not sure which one it is? That’s fine.
    </p>
  </div>
</section>
